module CdrStreamParamHeader {
  @final
  struct t1 {
    @optional long f1;
  };

  @final
  struct t2 {
    @optional @id(321) boolean f1;
    @optional @id(123) long f2;
  };

  @final
  struct t3_1 {
    @optional @id(10) boolean s1;
  };
  @appendable
  struct t3 {
    t3_1 f1;
    @optional @id(99) string f2;
    @optional long long f3;
  };

};

module CdrStreamAppendable {
  @final
  struct f1 {
    long m1;
    long m2;
  };

  @appendable
  struct a1 {
    long m1;
    long m2;
  };

  @appendable
  struct a1_key {
    @key long m1;
  };

  @appendable
  struct narrow {
    long m1;
  };

  @appendable
  struct wide {
    long m1;
    long m2;
  };

  @appendable
  struct key_tail {
    long m1;
    @key long m2;
  };

  @appendable
  struct mu_tail {
    long m1;
    @must_understand long m2;
  };

  @appendable
  struct optional_mu_tail {
    long m1;
    @optional @must_understand long m2;
  };

  @appendable
  struct a2 {
    long m1;
    @optional long m2;
  };

  @appendable
  struct a3_1 {
    long s1;
    long s2;
  };
  @appendable
  struct a3 {
    long m1;
    @optional a3_1 m2;
  };

};

module CdrStreamMutable {
  @mutable
  struct t1 {
    @id(1) uint32 f1;
    @id(2) sequence<uint32> f2;
  };

  @mutable
  struct key_tail {
    @id(1) uint32 f1;
    @id(2) @key uint32 f2;
  };

  @mutable
  struct mu_tail {
    @id(1) uint32 f1;
    @id(2) @must_understand uint32 f2;
  };

  @mutable
  struct optional_mu_tail {
    @id(1) uint32 f1;
    @id(2) @optional @must_understand uint32 f2;
  };

  // Two inheritance levels exercise the flattened mutable member list.
  @mutable struct allocation_base {
    @id(1) @key string text;
    @id(2) @key @external long number;
    @id(5) @key wstring wide;
    @id(6) @key sequence<string> strings;
  };
  @mutable struct allocation_middle : allocation_base {
    @id(3) @optional short optional_values[2][2];
    @id(4) long defaulted;
  };
  @mutable struct allocation_derived : allocation_middle {
    @id(7) @optional long absent;
    @id(8) string derived_text;
  };
  @final struct allocation_sample {
    @external allocation_derived values[2];
    @key sequence<long> key;
  };
  @final struct allocation_optional_sample {
    @optional allocation_derived values[2];
    // Force extraction through a temporary sample, including non-key values.
    @key sequence<long> key;
  };
  @final struct allocation_key_sample {
    @key @external allocation_base values[2];
  };
};
