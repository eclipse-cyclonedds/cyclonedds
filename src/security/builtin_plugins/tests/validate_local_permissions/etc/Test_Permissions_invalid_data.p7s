                 </id_range>
                 <id>200</id>
                </domains>
                <publish>
                    <topics>
                        <topic>P*</topic>
                        <topic>*WrongMessage</topic>
                        <topic>FakeMessanger</topic>
                        <topic>ChangedMessage</topic>
                    </topics>
		    <partitions>
			<partition>Apart</partition>
			<partition>Bpa?t*</partition>
		    </partitions>
                </publish>
                <subscribe>
                    <topics>
                        <topic>P*</topic>
                        <topic>*WrongMessage</topic>
